# Application
APP_NAME=droid-ai-engineer
LOG_LEVEL=INFO

# Database (inside Docker this defaults to sqlite:////data/tasks.db)
DATABASE_URL=sqlite:///./data/tasks.db

# Operator access
# protected (default; anything unrecognised is also protected) | local_dev
# (explicitly unauthenticated, for local development only)
FORGE_ACCESS_MODE=protected
# Single-operator credential, at least 32 random characters. Used on /login and
# as `Authorization: Bearer <token>` for API clients. Protected mode returns 503
# rather than allowing anonymous access when this is missing or too short.
FORGE_OPERATOR_TOKEN=
# Absolute browser session lifetime (seconds)
FORGE_SESSION_TTL_SECONDS=28800
# Host header values the app answers to (PUBLIC_BASE_URL's host is added)
FORGE_TRUSTED_HOSTS=127.0.0.1,localhost,::1
# Session cookie Secure flag: auto (Secure except plain-HTTP loopback) | true | false
FORGE_COOKIE_SECURE=auto
# Comma-separated owner/repo slugs approved for registration, intake, work,
# reviews and polling. Empty approves nothing in protected mode.
FORGE_ALLOWED_REPOSITORIES=
# Comma-separated branch names the app may push to or open a PR from. Empty
# approves nothing in protected mode.
FORGE_ALLOWED_BRANCHES=
# Master switch for every GitHub write (comments, labels, issues, PRs, reviews,
# pushes). Merging, auto-merge and webhook installation are never permitted.
FORGE_ALLOW_GITHUB_WRITES=false
# Stored per-repository setup commands run only with this explicit opt-in.
FORGE_ALLOW_PRIVILEGED_SETUP=false
# Local acceptance checks the app runs on a clean checkout of the exact candidate
# before approval: JSON list of {"name", "argv", "timeout_seconds"} (no shell).
# Empty means not configured, which blocks approval.
# FORGE_ACCEPTANCE_CHECKS=[{"name": "tests", "argv": ["python", "-m", "pytest", "-q"], "timeout_seconds": 1200}]
FORGE_ACCEPTANCE_CHECKS=

# GitHub
PUBLIC_BASE_URL=
# Shared secret used to validate webhook signatures (X-Hub-Signature-256).
# Webhook intake is disabled (503) when empty.
GITHUB_WEBHOOK_SECRET=change-me
# Personal access token with repo scope. Only app-owned operations use it
# (clone/fetch, policy-approved pushes, PRs, comments, reviews); it is never
# written to a Git remote or passed to agent sessions.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Droid (Factory) agent runtime
# Factory API key from https://app.factory.ai/settings/api-keys. The official
# Python SDK (`droid-sdk`) runs local `droid` sessions and reads this key.
# For local runs you may instead leave it empty and set DROID_ALLOW_CLI_AUTH=true
# to use the droid CLI's own login. Inside Docker always set the key.
FACTORY_API_KEY=
# Use the local droid CLI's authentication when FACTORY_API_KEY is empty
DROID_ALLOW_CLI_AUTH=false
# Model id for new sessions; "auto" = Factory Router. Per-repo overrides in the dashboard.
DROID_MODEL=auto
# Autonomy for fix sessions: off | low | medium | high
DROID_AUTONOMY=high
# PR review sessions ignore autonomy: they are always restricted to Read, Grep and Glob.
# Wall-clock budget for one Droid turn (seconds)
DROID_TURN_TIMEOUT_SECONDS=3600
# Paid turns allowed at once across implementation, review, follow-up and recovery
FORGE_MAX_CONCURRENT_RUNS=1
# Follow-up + recovery turns allowed per implementation task
FORGE_MAX_CONTINUATIONS=3
# Spending check before every paid turn: none | account_cap | credit_limit
# (any other value blocks every paid turn). account_cap records an account-level
# USD cap enforced by Factory billing; Forge does not enforce dollars itself.
FORGE_BUDGET_POLICY=none
FORGE_DEMO_ACCOUNT_CAP_USD=
# credit_limit: observed Factory credits allowed before new turns are blocked
FORGE_CREDIT_LIMIT=
# Where per-task repository workspace clones live
WORKSPACE_ROOT=./data/workspace

# Automation behaviour
POLL_INTERVAL_SECONDS=20
TRIGGER_LABEL=Droid-complete
# Forge never merges or enables auto-merge; the old REVIEW_AUTO_MERGE setting is ignored.

# ROI assumptions (dashboard productivity math)
JUNIOR_SWE_ANNUAL_COST_USD=150000
JUNIOR_HOURS_PER_ISSUE=4.0
JUNIOR_HOURS_PER_REVIEW=1.0
# Flat estimated USD attributed per completed Droid run when real Factory credit
# usage is unavailable (set 0 to ignore)
DROID_USD_PER_AGENT_RUN=0
# Optional explicit credit-to-USD *estimate* (never a verified billing rate).
# Applied to attempts with observed credits only when both values are set.
FORGE_USD_PER_CREDIT_ESTIMATE=
FORGE_USD_ESTIMATE_SOURCE=

# Optional error tracking (Sentry). Empty = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Optional product analytics (PostHog). Empty = disabled; events never block
# product flows.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
