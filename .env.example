# Application
APP_NAME=devin-ai-engineer
LOG_LEVEL=INFO

# Database (inside Docker this defaults to sqlite:////data/tasks.db)
DATABASE_URL=sqlite:///./data/tasks.db

# GitHub
# Shared secret used to validate webhook signatures (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=change-me
# Personal access token with repo scope (used to post issue comments)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Devin (service user key starts with cog_)
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai/v3
# Organization ID from Settings > Service Users (prefix: org-)
DEVIN_ORG_ID=
# Attribute sessions to a real Devin user instead of the "bot_apk" pseudo-user
# that service-user keys default to. Leave blank to keep service-user attribution.
# Requires the service user to hold ImpersonateOrgSessions (prefix: user-)
DEVIN_CREATE_AS_USER_ID=
# Tag applied to every session created by this app
DEVIN_SESSION_TAG=devin-forge

# Automation behaviour
POLL_INTERVAL_SECONDS=20
TRIGGER_LABEL=Devin-complete

# ROI assumptions (dashboard productivity math)
JUNIOR_SWE_ANNUAL_COST_USD=150000
JUNIOR_HOURS_PER_ISSUE=4.0
JUNIOR_HOURS_PER_REVIEW=1.0
DEVIN_ACU_USD=2.25
