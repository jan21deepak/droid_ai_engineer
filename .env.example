# Application
APP_NAME=cursor-ai-engineer
LOG_LEVEL=INFO

# Database (inside Docker this defaults to sqlite:////data/tasks.db)
DATABASE_URL=sqlite:///./data/tasks.db

# GitHub
# Shared secret used to validate webhook signatures (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=change-me
# Personal access token with repo scope (used to post issue comments / merge PRs)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Cursor Cloud Agents API
# User API key from https://cursor.com/dashboard/integrations (or a team service-account key)
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
# Optional model id from GET /v1/models — leave blank for account default
CURSOR_MODEL=
# Prefix applied to agent display names in the Cursor UI
CURSOR_NAME_PREFIX=cursor-forge
# Default git ref for new fix agents
CURSOR_STARTING_REF=main

# Automation behaviour
POLL_INTERVAL_SECONDS=20
TRIGGER_LABEL=Cursor-complete

# ROI assumptions (dashboard productivity math)
JUNIOR_SWE_ANNUAL_COST_USD=150000
JUNIOR_HOURS_PER_ISSUE=4.0
JUNIOR_HOURS_PER_REVIEW=1.0
# Flat USD attributed per completed Cursor agent run (set to your estimate)
CURSOR_USD_PER_AGENT_RUN=0
