flowchart LR
    ISSUE["GitHub Issue<br/>labeled Droid-complete"]
    WEBHOOK["Droid Forge FastAPI<br/>POST /webhook / Assign"]
    DB[("SQLite<br/>Task + Repo store<br/>per-repo model + setup cmd")]
    WS["Workspace Clones<br/>token-authenticated origin"]
    SDK["droid-sdk Sessions<br/>autonomy HIGH"]
    FIX["Droid Fix Agent<br/>code, test, push branch"]
    PR["Same-repo Pull Request<br/>via GitHub PAT"]
    REVIEW["Droid Review Session<br/>on PR head branch"]
    PRREVIEW["GitHub PR Review<br/>approve / request changes"]
    WORKER["Worker loop<br/>PR state + merge tracking"]
    COMMENT["GitHub Comment<br/>issue + merge tracking"]
    DASH["Dashboard<br/>GET /dashboard"]
    METRICS["Metrics<br/>GET /metrics"]

    ISSUE -->|"webhook / assign"| WEBHOOK
    WEBHOOK -->|"persist Task"| DB
    DB -->|"model + setup command"| WS
    WEBHOOK -->|"launch background task"| SDK
    WS -->|"session cwd"| SDK
    SDK --> FIX
    FIX -->|"BRANCH: pushed"| PR
    PR --> REVIEW
    REVIEW -->|"verdict"| PRREVIEW
    FIX -->|"summary, duration, credits"| COMMENT
    WORKER -->|"PR open/merged"| DB
    DB -.-> DASH
    DB -.-> METRICS

    classDef droid fill:#a855f7,stroke:#6b21a8,color:#fff
    classDef gh fill:#10b981,stroke:#047857,color:#fff
    class SDK,FIX,REVIEW droid
    class PR,PRREVIEW,COMMENT gh
