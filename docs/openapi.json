{
  "components": {
    "schemas": {
      "AddRepositoryRequest": {
        "properties": {
          "droid_model": {
            "default": "",
            "description": "Optional per-repo model id override (empty = DROID_MODEL)",
            "title": "Droid Model",
            "type": "string"
          },
          "setup_command": {
            "default": "",
            "description": "Optional shell command for the workspace clone; stored only. It runs before the session only when FORGE_ALLOW_PRIVILEGED_SETUP=true",
            "title": "Setup Command",
            "type": "string"
          },
          "starting_ref": {
            "default": "",
            "description": "Optional git ref used when cloning the workspace",
            "title": "Starting Ref",
            "type": "string"
          },
          "url": {
            "description": "GitHub repository URL or owner/repo slug",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "AddRepositoryRequest",
        "type": "object"
      },
      "AssignIssuesRequest": {
        "properties": {
          "issue_ids": {
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "title": "Issue Ids",
            "type": "array"
          }
        },
        "required": [
          "issue_ids"
        ],
        "title": "AssignIssuesRequest",
        "type": "object"
      },
      "AssignPullsRequest": {
        "properties": {
          "pull_ids": {
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "title": "Pull Ids",
            "type": "array"
          }
        },
        "required": [
          "pull_ids"
        ],
        "title": "AssignPullsRequest",
        "type": "object"
      },
      "FollowUpRequest": {
        "properties": {
          "instruction": {
            "description": "Follow-up prompt for the existing Droid session",
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "FollowUpRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "UpdateRepositoryRequest": {
        "properties": {
          "droid_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional per-repo model id override (empty = DROID_MODEL)",
            "title": "Droid Model"
          },
          "setup_command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional shell command for the workspace clone; stored only. It runs before the session only when FORGE_ALLOW_PRIVILEGED_SETUP=true",
            "title": "Setup Command"
          },
          "starting_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional git ref used when cloning the workspace",
            "title": "Starting Ref"
          }
        },
        "title": "UpdateRepositoryRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
