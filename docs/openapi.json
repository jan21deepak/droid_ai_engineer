    "/api/issues/assign": {
      "post": {
        "description": "Dispatch selected issues to Droid, labeling them on GitHub when policy permits.\n\nIssues outside repository policy are rejected before any call. With GitHub\nwrites permitted, the trigger label is applied; when ``PUBLIC_BASE_URL`` is\nconfigured, forge waits briefly for the webhook to create the task.\nOtherwise it dispatches the Droid session directly (same end state, with\nduplicate protection if the webhook also fires).",
        "operationId": "assign_issues_to_droid_api_issues_assign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignIssuesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assign Issues To Droid"
      }
    },
